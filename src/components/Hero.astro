---
import Button from './Button.astro';
---

<section class="max-w-5xl mx-auto px-6 py-24 sm:py-32">
  <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight">
    გიორგი ლომიძე
  </h1>
  <p class="mt-4 text-xl sm:text-2xl text-muted">
    მშენებლობის ეტაპების სპეციალისტი
  </p>
  <p class="mt-8 text-lg text-primary max-w-2xl leading-relaxed">
    ვუზრუნველყოფ მშენებლობის ყოველი ეტაპის დოკუმენტურ აღრიცხვას — ფოტოთი, ოქმით და საჯარო რეესტრთან თანხვედრით.
  </p>
  <div class="mt-12 flex flex-wrap gap-4">
    <Button href="/contact" variant="primary">კონტაქტი</Button>
    <Button href="/projects" variant="secondary">პროექტების ნახვა</Button>
  </div>
</section>
