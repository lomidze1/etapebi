---
const navItems = [
  { href: '/', label: 'მთავარი' },
  { href: '/services', label: 'მომსახურება' },
  { href: '/projects', label: 'პროექტები' },
  { href: '/about', label: 'შესახებ' },
  { href: '/contact', label: 'კონტაქტი' },
];

const rawPath = Astro.url.pathname.replace(/\/$/, '');
const pathname = rawPath === '' ? '/' : rawPath;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="border-b border-subtle">
  <div
    class="max-w-5xl mx-auto px-6 py-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
  >
    <a
      href="/"
      class="text-lg font-medium tracking-tight hover:text-primary transition-colors"
      aria-label="გიორგი ლომიძე — მთავარ გვერდზე დაბრუნება"
    >
      გიორგი ლომიძე
    </a>
    <nav aria-label="ძირითადი ნავიგაცია">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        {
          navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'transition-colors hover:text-primary',
                    active ? 'text-primary' : 'text-muted',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
