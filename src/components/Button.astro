---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  ariaLabel?: string;
}

const { href, variant = 'primary', ariaLabel } = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center px-6 py-3 font-medium transition-opacity hover:opacity-90';

const variantClasses =
  variant === 'primary'
    ? 'bg-primary text-base'
    : 'border-2 border-primary text-primary';
---

<a
  href={href}
  aria-label={ariaLabel}
  class:list={[baseClasses, variantClasses]}
>
  <slot />
</a>
