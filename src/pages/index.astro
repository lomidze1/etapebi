---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Container from '../components/Container.astro';
import { getCollection } from 'astro:content';

const services = [
  {
    title: 'ეტაპობრივი ფოტოანგარიში',
    description:
      'ვაფიქსირებ მშენებლობის ყოველი ეტაპის ფაქტობრივ მდგომარეობას ერთიანი მეთოდოლოგიით. შედეგი — სრული ფოტოანგარიში თარიღით და ხედის სტრუქტურით.',
  },
  {
    title: 'ოქმების მომზადება',
    description:
      'ვამზადებ ეტაპის დასრულების ოქმს — ფაქტებით, თარიღით და ნებართვის ნომრით. ოქმი მზადდება საჯარო რეესტრის სტანდარტული ფორმის შესაბამისად.',
  },
  {
    title: 'დოკუმენტური აღრიცხვა',
    description:
      'ვაერთიანებ ეტაპის ფოტოანგარიშს, ოქმს და თანდართულ ნახაზებს ერთ პაკეტში. მესაკუთრე იღებს სრულ აღრიცხვას, რომელიც აკმაყოფილებს საჯარო რეესტრის მოთხოვნებს.',
  },
];

const recentProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 2);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'გიორგი ლომიძე',
  url: 'https://etapebi.com',
  inLanguage: 'ka',
};
---

<BaseLayout
  title="გიორგი ლომიძე — მშენებლობის ეტაპების სპეციალისტი"
  description="ეტაპობრივი ფოტოანგარიში, ოქმების მომზადება და დოკუმენტური აღრიცხვა მშენებლობის პროცესისთვის. დამოუკიდებელი სპეციალისტი ხაშურსა და საქართველოს მასშტაბით."
  extraJsonLd={[websiteJsonLd]}
>
  <Hero />

  <Container as="section" aria-labelledby="services-heading" class="py-16 sm:py-24">
    <h2
      id="services-heading"
      class="text-3xl sm:text-4xl font-medium tracking-tight"
    >
      მომსახურება
    </h2>
    <p class="mt-4 text-muted max-w-2xl">
      სამი ძირითადი მიმართულება — ეტაპობრივი ფოტოანგარიში, ოქმების მომზადება, დოკუმენტური აღრიცხვა.
    </p>
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        services.map((s) => (
          <ServiceCard title={s.title} description={s.description} />
        ))
      }
    </div>
  </Container>

  <ProcessSteps />

  {
    recentProjects.length > 0 && (
      <Container as="section" aria-labelledby="recent-heading" class="py-16 sm:py-24">
        <h2
          id="recent-heading"
          class="text-3xl sm:text-4xl font-medium tracking-tight"
        >
          უახლესი პროექტები
        </h2>
        <p class="mt-4 text-muted max-w-2xl">
          დასრულებული და მიმდინარე ობიექტების ფოტოანგარიშები.
        </p>
        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-8">
          {recentProjects.map((p) => (
            <ProjectCard project={p} headingLevel="h3" />
          ))}
        </div>
        <div class="mt-10">
          <a
            href="/projects"
            class="inline-flex items-center gap-2 py-2 text-sm text-muted underline underline-offset-4 hover:text-primary transition-colors"
          >
            ყველა პროექტის ნახვა
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </a>
        </div>
      </Container>
    )
  }

  <ContactCTA />
</BaseLayout>
