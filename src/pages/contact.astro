---
import BaseLayout from '../layouts/BaseLayout.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const url = new URL(Astro.request.url);
const sent = url.searchParams.get('sent') === '1';
const errorParam = url.searchParams.get('error');

const errorMessages: Record<string, string> = {
  name: 'სახელი — მინიმუმ 2 სიმბოლო.',
  phone: 'ტელეფონი — შეიყვანეთ მოქმედი ნომერი.',
  email: 'ემაილი — შეამოწმეთ ფორმატი.',
  message: 'შეტყობინება — მინიმუმ 10 სიმბოლო და ერთი გამოტოვება.',
  turnstile: 'spam-შემოწმება ვერ გავიდა — სცადეთ ხელახლა.',
  server: 'სერვერის შეცდომა — სცადეთ მოგვიანებით ან დაუკავშირდით ტელეფონით.',
};

const fallbackErrors = errorParam
  ? errorParam
      .split(',')
      .map((code) => errorMessages[code] ?? null)
      .filter((m): m is string => Boolean(m))
  : [];
---

<BaseLayout
  title="კონტაქტი — გიორგი ლომიძე"
  description="დაუკავშირდით გიორგი ლომიძეს ფოტოანგარიშისა და ოქმების მოსამზადებლად — ტელეფონი, ემაილი, წერილობითი მოთხოვნა."
>
  <section class="max-w-2xl mx-auto px-6 py-16 sm:py-24">
    <h1 class="text-4xl sm:text-5xl font-medium tracking-tight">კონტაქტი</h1>
    <p class="mt-6 text-base sm:text-lg text-muted">
      პირდაპირი კონტაქტი — ტელეფონი, ემაილი ან წერილობითი მოთხოვნა ფორმით.
    </p>

    <dl class="mt-12 space-y-3 text-primary">
      <div class="flex flex-wrap gap-x-3">
        <dt class="text-muted">ტელეფონი:</dt>
        <dd>
          <a href="tel:+995593502093" class="hover:opacity-80 transition-opacity">
            +995 593 50 20 93
          </a>
        </dd>
      </div>
      <div class="flex flex-wrap gap-x-3">
        <dt class="text-muted">ემაილი:</dt>
        <dd>
          <a href="mailto:info@etapebi.com" class="hover:opacity-80 transition-opacity">
            info@etapebi.com
          </a>
        </dd>
      </div>
      <div class="flex flex-wrap gap-x-3">
        <dt class="text-muted">სამოქმედო ზონა:</dt>
        <dd>ხაშური და საქართველოს მასშტაბით.</dd>
      </div>
    </dl>

    <noscript>
      {
        sent && (
          <div
            role="status"
            class="mt-12 p-6 bg-elevated border border-primary text-primary"
          >
            შეტყობინება მიღებულია. გიპასუხებთ მცირე ვადაში.
          </div>
        )
      }
      {
        fallbackErrors.length > 0 && !sent && (
          <div
            role="alert"
            class="mt-12 p-6 bg-elevated border border-danger text-primary"
          >
            <p class="font-medium">გაგზავნა ვერ მოხერხდა:</p>
            <ul class="mt-2 list-disc pl-5 text-sm">
              {fallbackErrors.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          </div>
        )
      }
    </noscript>

    <form
      id="contact-form"
      method="POST"
      action="/api/contact"
      class="mt-12 space-y-6"
      aria-labelledby="form-heading"
      novalidate
    >
      <h2 id="form-heading" class="text-2xl font-medium tracking-tight">
        წერილობითი მოთხოვნა
      </h2>

      <div>
        <label for="name" class="block text-sm font-medium text-muted">
          სახელი
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          minlength="2"
          maxlength="100"
          autocomplete="name"
          aria-describedby="name-error"
          class="mt-2 w-full bg-elevated border border-subtle px-4 py-3 text-primary focus:border-primary aria-[invalid=true]:border-danger"
        />
        <p
          id="name-error"
          data-error-for="name"
          class="mt-1 text-sm text-danger hidden"
        >
        </p>
      </div>

      <div>
        <label for="phone" class="block text-sm font-medium text-muted">
          ტელეფონი
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          inputmode="tel"
          maxlength="30"
          autocomplete="tel"
          aria-describedby="phone-error"
          class="mt-2 w-full bg-elevated border border-subtle px-4 py-3 text-primary focus:border-primary aria-[invalid=true]:border-danger"
        />
        <p
          id="phone-error"
          data-error-for="phone"
          class="mt-1 text-sm text-danger hidden"
        >
        </p>
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-muted">
          ემაილი (სურვილისამებრ)
        </label>
        <input
          type="email"
          id="email"
          name="email"
          maxlength="200"
          autocomplete="email"
          aria-describedby="email-error"
          class="mt-2 w-full bg-elevated border border-subtle px-4 py-3 text-primary focus:border-primary aria-[invalid=true]:border-danger"
        />
        <p
          id="email-error"
          data-error-for="email"
          class="mt-1 text-sm text-danger hidden"
        >
        </p>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-muted">
          შეტყობინება
        </label>
        <textarea
          id="message"
          name="message"
          required
          minlength="10"
          maxlength="5000"
          rows="6"
          aria-describedby="message-error"
          class="mt-2 w-full bg-elevated border border-subtle px-4 py-3 text-primary focus:border-primary resize-y aria-[invalid=true]:border-danger"
        ></textarea>
        <p
          id="message-error"
          data-error-for="message"
          class="mt-1 text-sm text-danger hidden"
        >
        </p>
      </div>

      {
        turnstileSiteKey && (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="dark"
          />
        )
      }

      <p
        id="form-status"
        role="alert"
        aria-live="polite"
        class="text-sm text-danger hidden"
      >
      </p>

      <button
        type="submit"
        class="inline-flex items-center justify-center px-6 py-3 font-medium bg-primary text-base transition-opacity hover:opacity-90 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        შეტყობინების გაგზავნა
      </button>
    </form>

    <div
      id="success-card"
      role="status"
      aria-live="polite"
      hidden
      class="mt-12 p-8 bg-elevated border border-subtle"
    >
      <h2 class="text-2xl font-medium tracking-tight">
        შეტყობინება გაიგზავნა
      </h2>
      <p class="mt-3 text-muted">
        გმადლობთ. მალე დაგიკავშირდებით.
      </p>
      <div class="mt-6">
        <a
          id="success-home"
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 font-medium bg-primary text-base transition-opacity hover:opacity-90"
        >
          მთავარზე დაბრუნება
        </a>
      </div>
      <div
        class="mt-8 h-0.5 w-full bg-subtle overflow-hidden"
        aria-hidden="true"
      >
        <div id="success-progress" class="h-full w-0 bg-primary"></div>
      </div>
    </div>
  </section>

  {
    turnstileSiteKey && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )
  }

  <style>
    @keyframes progress-fill {
      from {
        width: 0%;
      }
      to {
        width: 100%;
      }
    }

    #success-progress.run {
      animation: progress-fill 4s linear forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      #success-progress.run {
        animation: none;
        width: 100%;
      }
    }
  </style>

  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      if (!form) return;

      const PHONE_RE = /^[+]?[\d\s]{6,30}$/;
      const PHONE_MIN_DIGITS = 6;
      const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

      const MESSAGES = {
        name: 'სახელი — მინიმუმ 2 სიმბოლო.',
        phone: 'ტელეფონი — შეიყვანეთ მოქმედი ნომერი.',
        email: 'ემაილი — შეამოწმეთ ფორმატი.',
        message: 'შეტყობინება — მინიმუმ 10 სიმბოლო და ერთი გამოტოვება.',
        turnstile: 'spam-შემოწმება ვერ გავიდა — სცადეთ ხელახლა.',
        server: 'სერვერის შეცდომა — სცადეთ მოგვიანებით ან დაუკავშირდით ტელეფონით.',
        network: 'კავშირის შეცდომა — შეამოწმეთ ინტერნეტი და სცადეთ ხელახლა.',
      };

      const nameInput = form.querySelector('input[name="name"]');
      const phoneInput = form.querySelector('input[name="phone"]');
      const emailInput = form.querySelector('input[name="email"]');
      const messageInput = form.querySelector('textarea[name="message"]');
      const submitBtn = form.querySelector('button[type="submit"]');
      const statusEl = document.getElementById('form-status');
      const successCard = document.getElementById('success-card');
      const successProgress = document.getElementById('success-progress');
      const successHome = document.getElementById('success-home');

      function setError(field, code) {
        const errEl = form.querySelector('[data-error-for="' + field + '"]');
        const input = form.querySelector('[name="' + field + '"]');
        if (!errEl || !input) return;
        if (code) {
          errEl.textContent = MESSAGES[code] || '';
          errEl.classList.remove('hidden');
          input.setAttribute('aria-invalid', 'true');
        } else {
          errEl.textContent = '';
          errEl.classList.add('hidden');
          input.removeAttribute('aria-invalid');
        }
      }

      function validateName() {
        const v = (nameInput.value || '').trim();
        if (v.length < 2 || v.length > 100) {
          setError('name', 'name');
          return false;
        }
        setError('name', null);
        return true;
      }

      function validatePhone() {
        const v = (phoneInput.value || '').trim();
        const digits = v.replace(/\D/g, '');
        if (!v || !PHONE_RE.test(v) || digits.length < PHONE_MIN_DIGITS) {
          setError('phone', 'phone');
          return false;
        }
        setError('phone', null);
        return true;
      }

      function validateEmail() {
        const v = (emailInput.value || '').trim();
        if (v && !EMAIL_RE.test(v)) {
          setError('email', 'email');
          return false;
        }
        setError('email', null);
        return true;
      }

      function validateMessage() {
        const v = (messageInput.value || '').trim();
        if (v.length < 10 || v.length > 5000 || !/\s/.test(v)) {
          setError('message', 'message');
          return false;
        }
        setError('message', null);
        return true;
      }

      phoneInput.addEventListener('input', function () {
        const cleaned = phoneInput.value.replace(/[^\d+\s]/g, '');
        if (cleaned !== phoneInput.value) {
          phoneInput.value = cleaned;
        }
      });

      nameInput.addEventListener('blur', validateName);
      nameInput.addEventListener('input', function () {
        if (nameInput.hasAttribute('aria-invalid')) validateName();
      });

      phoneInput.addEventListener('blur', validatePhone);
      phoneInput.addEventListener('input', function () {
        if (phoneInput.hasAttribute('aria-invalid')) validatePhone();
      });

      emailInput.addEventListener('blur', validateEmail);
      emailInput.addEventListener('input', function () {
        if (emailInput.hasAttribute('aria-invalid')) validateEmail();
      });

      messageInput.addEventListener('blur', validateMessage);
      messageInput.addEventListener('input', function () {
        if (messageInput.hasAttribute('aria-invalid')) validateMessage();
      });

      function showStatus(text) {
        statusEl.textContent = text;
        statusEl.classList.toggle('hidden', !text);
      }

      function handleServerErrors(codes) {
        const fieldCodes = ['name', 'phone', 'email', 'message'];
        let firstInvalid = null;
        codes.forEach(function (code) {
          if (fieldCodes.indexOf(code) !== -1) {
            setError(code, code);
            if (!firstInvalid) firstInvalid = form.querySelector('[name="' + code + '"]');
          }
        });
        const generalCodes = codes.filter(function (c) {
          return fieldCodes.indexOf(c) === -1;
        });
        if (generalCodes.length > 0) {
          const msgs = generalCodes
            .map(function (c) {
              return MESSAGES[c] || MESSAGES.server;
            })
            .join(' ');
          showStatus(msgs);
        } else {
          showStatus('');
        }
        if (firstInvalid) firstInvalid.focus();
      }

      let redirectTimer = null;
      function goHome() {
        if (redirectTimer) {
          clearTimeout(redirectTimer);
          redirectTimer = null;
        }
        window.location.href = '/';
      }

      successHome.addEventListener('click', function (e) {
        e.preventDefault();
        goHome();
      });

      function showSuccess() {
        form.hidden = true;
        successCard.hidden = false;
        successProgress.classList.add('run');
        successCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        redirectTimer = setTimeout(goHome, 4000);
      }

      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        showStatus('');

        const validations = [
          validateName(),
          validatePhone(),
          validateEmail(),
          validateMessage(),
        ];
        if (validations.indexOf(false) !== -1) {
          const firstInvalid = form.querySelector('[aria-invalid="true"]');
          if (firstInvalid) firstInvalid.focus();
          return;
        }

        submitBtn.disabled = true;
        try {
          const fd = new FormData(form);
          const res = await fetch(form.action, {
            method: 'POST',
            body: fd,
            headers: { Accept: 'application/json' },
          });

          let data = null;
          try {
            data = await res.json();
          } catch (_) {
            data = null;
          }

          if (res.ok && data && data.ok) {
            showSuccess();
            return;
          }

          if (data && Array.isArray(data.errors) && data.errors.length > 0) {
            handleServerErrors(data.errors);
          } else {
            showStatus(MESSAGES.server);
          }
        } catch (_) {
          showStatus(MESSAGES.network);
        } finally {
          submitBtn.disabled = false;
        }
      });
    })();
  </script>
</BaseLayout>
