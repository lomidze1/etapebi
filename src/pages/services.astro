---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---

<BaseLayout
  title="მომსახურება — გიორგი ლომიძე"
  description="ფოტოანგარიში, ოქმების მომზადება და მშენებლობის ეტაპების დოკუმენტური აღრიცხვა — სამოქმედო ზონა საქართველოს მასშტაბით."
>
  <Container as="section" class="py-16 sm:py-24">
    <h1 class="text-4xl sm:text-5xl font-medium tracking-tight">მომსახურება</h1>
    <p class="mt-6 text-base sm:text-lg text-muted max-w-2xl">
      მშენებლობის ყოველი ეტაპის ფიქსაცია — ფოტომასალა, ოქმი და დოკუმენტური ანგარიში.
    </p>
  </Container>
</BaseLayout>
