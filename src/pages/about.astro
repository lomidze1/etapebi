---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="შესახებ — გიორგი ლომიძე"
  description="დამოუკიდებელი სპეციალისტი მშენებლობის ეტაპების აღრიცხვაში — მიდგომა, გამოცდილება და სამუშაო პრინციპები საქართველოში."
>
  <article class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
    <h1 class="text-4xl sm:text-5xl font-medium tracking-tight">შესახებ</h1>

    <section class="mt-10 sm:mt-12">
      <h2 class="text-xl sm:text-2xl font-medium tracking-tight">ვინ არის გიორგი ლომიძე</h2>
      <p class="mt-4 text-base sm:text-lg text-primary leading-relaxed">
        გიორგი ლომიძე — დამოუკიდებელი სპეციალისტი მშენებლობის ეტაპების დოკუმენტურ აღრიცხვაში. ვმუშაობ საქართველოს მასშტაბით — ფოკუსი ფაქტობრივ ფიქსაციაზეა, არა მარკეტინგზე.
      </p>
    </section>

    <section class="mt-10 sm:mt-12">
      <h2 class="text-xl sm:text-2xl font-medium tracking-tight">მიდგომა</h2>
      <p class="mt-4 text-base sm:text-lg text-primary leading-relaxed">
        მუშაობა იწყება ობიექტის დათვალიერებით და ნებართვის დოკუმენტების გადახედვით. ეტაპის დასრულებისთანავე ვაფიქსირებ ფაქტობრივ მდგომარეობას — ფოტოთი, ოქმით და საკადასტრო კოდთან თანხვედრით.
      </p>
      <p class="mt-4 text-base sm:text-lg text-primary leading-relaxed">
        ვმუშაობ მშენებლობის ნებართვას, ეტაპის ოქმებს, საჯარო რეესტრის ჩანაწერებსა და ნაგებობის კლასის სერთიფიკატებს. ყოველ ფაილს ვაერთიანებ ერთ ანგარიშში — მესაკუთრე იღებს სრულ პაკეტს ეტაპის დასრულებიდან მცირე ვადაში.
      </p>
    </section>

    <section class="mt-10 sm:mt-12">
      <h2 class="text-xl sm:text-2xl font-medium tracking-tight">რატომ ცალკე სპეციალისტი</h2>
      <p class="mt-4 text-base sm:text-lg text-primary leading-relaxed">
        მშენებელი კომპანია მთავარი სამუშაოთი დაკავებულია — ფიზიკური მშენებლობით. დოკუმენტური აღრიცხვა ცალკე სპეციალისტს მოითხოვს, ფოკუსირებულს ფაქტობრივ ფიქსაციაზე და საჯარო რეესტრის მოთხოვნებთან თანხვედრაზე. ცალკე ხედი ამცირებს შეცდომას და ექსპერტიზის გადაკვეთას.
      </p>
    </section>

    <section class="mt-10 sm:mt-12">
      <h2 class="text-xl sm:text-2xl font-medium tracking-tight">სამოქმედო ზონა</h2>
      <p class="mt-4 text-base sm:text-lg text-primary leading-relaxed">
        სამოქმედო ზონა — საქართველოს მასშტაბით ნებისმიერი ობიექტი.
      </p>
    </section>

    <div class="mt-12 sm:mt-16">
      <Button href="/contact" variant="primary">
        შეტყობინების გაგზავნა
      </Button>
    </div>
  </article>
</BaseLayout>
